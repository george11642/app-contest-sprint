{
  "name": "app-contest-video-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit -p . && python3 scripts/check_beats.py",
    "vo:scratch": "python3 scripts/vo.py scratch && python3 scripts/timeline.py && python3 scripts/fix_timing.py --write && sh scripts/beds.sh",
    "vo:build": "python3 scripts/vo.py build && python3 scripts/timeline.py && python3 scripts/fix_timing.py --write && sh scripts/beds.sh",
    "still": "node scripts/stills.mjs out/chk/a",
    "clip": "remotion render src/index.ts Hybrid out/clip.mp4 --codec=h264 --crf=20",
    "render:final": "sh scripts/render_final.sh",
    "check:final": "sh scripts/check_final.sh out/final.mp4"
  },
  "dependencies": {
    "@react-three/fiber": "9.3.0",
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/media": "4.0.538",
    "@remotion/media-utils": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/three": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.538",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/three": "0.178.1",
    "typescript": "5.8.3"
  }
}
